        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="Theme.FlyLight_Application" parent="Base.Theme.FlyLight_Application" />

    <style name="Theme.FlyLight_Application.About" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="actionBarStyle">@style/AppActionBar</item>
